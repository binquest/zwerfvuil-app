# Environment for the local Edge Functions. Copy to supabase/functions/.env
# (gitignored) and restart Supabase (npm run db:stop && npm run db:start).

# Dev escape: accept a location picked on the map in the app, so check-ins can
# be tested at home. Local development only. Anything other than exactly "true"
# means off, and the function ignores it unless SUPABASE_URL is a local address.
# The database must be marked local as well (supabase/seed.sql does that).
# Leave APP_ENV unset locally: any other value than "local" switches the escape
# off, and makes the function refuse to start while ALLOW_FAKE_LOCATION is set.
ALLOW_FAKE_LOCATION=false
