# Staging configuration of the app. Copy to app/staging.env.local (gitignored)
# and fill in. Used by scripts/staging.mjs (npm run export:staging); EAS builds
# get the same values from the EAS environment "preview" instead.

# The Supabase API of the staging VM, published by tailscale serve:
#   ssh binquest-staging "tailscale status --json | jq -r .Self.DNSName"
EXPO_PUBLIC_SUPABASE_URL=https://binquest-staging.<tailnet>.ts.net

# Publishable key of staging (look it up in your own terminal, not in a chat):
#   ssh binquest-staging "sudo bq-secret SUPABASE_PUBLISHABLE_KEY"
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
