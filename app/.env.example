# App configuration. Copy to app/.env.local (gitignored) and fill in.
# Use .env.local, not .env: Expo only reads REACT_NATIVE_PACKAGER_HOSTNAME
# from .local env files.
#
# <PC_HOST> is the address of the PC running Supabase and Metro, as seen from
# the phone: its LAN IP (phone on the same Wi-Fi) or its Tailscale IP
# (phone on mobile data, see README "Testen op straat via Tailscale").

# Supabase API (port 54321 of the local stack).
EXPO_PUBLIC_SUPABASE_URL=http://<PC_HOST>:54321

# Publishable key of the local stack: `npm run supabase -- status` → "Publishable".
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Host that Metro advertises to Expo Go (the exp:// URL / QR code).
REACT_NATIVE_PACKAGER_HOSTNAME=<PC_HOST>
