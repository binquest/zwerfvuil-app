{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "dev",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_NO_DOTENV": "1"
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "staging": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_NO_DOTENV": "1"
      },
      "ios": {
        "buildConfiguration": "Release"
      }
    }
  }
}
