{
  "name": "zwerfvuil-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~57.0.24",
    "@expo/vector-icons": "^15.0.2",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.21",
    "expo-router": "~57.0.27",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@jest/globals": "29.7.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "doctor": "npx --yes expo-doctor@1.20.4",
    "export:staging": "node scripts/staging.mjs npx --yes expo export --platform ios --output-dir dist-staging --clear",
    "check:staging-bundle": "node scripts/staging.mjs npx --yes expo export --platform ios --output-dir dist-staging --clear --no-bytecode && node scripts/check-staging-bundle.mjs dist-staging",
    "test:scripts": "node --test scripts/staging.test.mjs scripts/icons.test.mjs scripts/sounds.test.mjs",
    "update:dev": "node scripts/update-dev.mjs",
    "sounds": "node scripts/sounds.mjs"
  },
  "private": true,
  "expo": {
    "install": {
      "//": "Excluded from expo install --check and expo-doctor: expo 57.0.28 and jest-expo 57.0.6 bring expo-modules-core 57.0.22, which does not accept react-native-worklets 0.13 (from expo-router); npm then nests expo-modules-core and Jest cannot find it. Retry with the next Expo patch (docs/PRE-BETA.md).",
      "exclude": [
        "expo",
        "jest-expo"
      ]
    }
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
