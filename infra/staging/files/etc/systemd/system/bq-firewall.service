# Managed by infra/staging (zwerfvuil-app).
# Loads only the nftables table bq_filter. The stock nftables.service is masked
# because stopping it runs `nft flush ruleset`, which would also wipe the rules
# of Docker and Tailscale.
[Unit]
Description=Host firewall (nftables table bq_filter)
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/bq/firewall.nft
ExecReload=/usr/sbin/nft -f /etc/bq/firewall.nft
ExecStop=/usr/sbin/nft delete table inet bq_filter

[Install]
WantedBy=sysinit.target
