# Non-secret settings of the Supabase stack on binquest-staging.
# Managed by infra/staging (zwerfvuil-app). Secrets are generated on the VM in
# /opt/binquest/secrets/supabase.env; the public URL is in host.env.
# Mirrors supabase/config.toml where the local stack has an equivalent.

# Database
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# API (PostgREST); config.toml: schemas, extra_search_path, max_rows
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
PGRST_DB_MAX_ROWS=1000

# Auth; config.toml: enable_signup, enable_confirmations = false, no phone or
# anonymous sign-ins
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
ADDITIONAL_REDIRECT_URLS=
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# Mail: Mailpit (mailcatcher, web UI only through the SSH tunnel) until a real
# SMTP provider is set up (Brevo, once there is a domain). See docs/STAGING.md.
SMTP_ADMIN_EMAIL=noreply@binquest-staging.invalid
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Zwerfvuil Gent (staging)

# Edge functions; config.toml: verify_jwt = true for submit-checkin
FUNCTIONS_VERIFY_JWT=true

# Studio (reached only through an SSH tunnel)
DASHBOARD_USERNAME=binquest
STUDIO_DEFAULT_ORGANIZATION=binquest
STUDIO_DEFAULT_PROJECT=zwerfvuil-staging
OPENAI_API_KEY=

# Storage: file backend on the data disk
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub

# Logs (Logflare + Vector)
DOCKER_SOCKET_LOCATION=/var/run/docker.sock

# API gateway (Envoy); the port binding itself is in docker-compose.bq.yml
API_GW_HTTP_PORT=8000

# Disabled services (realtime, imgproxy, supavisor); set so compose does not
# warn about unset variables
IMGPROXY_AUTO_WEBP=true
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5
POOLER_TENANT_ID=binquest-staging
