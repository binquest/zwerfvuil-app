#!/bin/sh
# Prints one value from /opt/binquest/secrets/supabase.env (root only).
# Managed by infra/staging (zwerfvuil-app). Used by stagingctl.py and the
# scripts in scripts/ (--target staging), which keep the value in memory.
# Look up a value yourself only in your own terminal, never in a chat:
#   ssh binquest-staging "sudo bq-secret DASHBOARD_PASSWORD"
set -eu
FILE=/opt/binquest/secrets/supabase.env
[ "$#" -eq 1 ] || { echo "usage: bq-secret NAME" >&2; exit 2; }
case "$1" in
  *[!A-Z0-9_]* | "") echo "bq-secret: invalid name" >&2; exit 2 ;;
esac
value=$(sed -n "s/^$1='\(.*\)'\$/\1/p" "$FILE" | tail -n 1)
[ -n "$value" ] || { echo "bq-secret: $1 not found" >&2; exit 1; }
printf '%s\n' "$value"
