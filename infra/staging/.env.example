# Settings for infra/staging/stagingctl.py. Copy to infra/staging/.env (gitignored).
# Every variable here is passed to the VM scripts as an environment variable.

# SSH alias of the staging VM in ~/.ssh/config (this is the default).
STAGING_SSH_HOST=binquest-staging

# The home LAN the VM is on. SSH is only allowed from here and from the tailnet.
# Logins from the PC may arrive from the router (Tailscale subnet router SNAT);
# that address must be inside this range.
LAN_CIDR=<LAN_CIDR>
