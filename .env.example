# Settings for the Python scripts in scripts/. Copy to .env (gitignored).
# Values set in your shell win over this file; command-line flags win over both.
#
# The other environment files:
#   app/.env.local              the Expo app (see app/.env.example)
#   supabase/functions/.env     the edge functions (see supabase/functions/.env.example)

# Account that scripts/seed-admin/seed_admin.py makes admin (or pass --email).
ADMIN_EMAIL=

# Database of the local Supabase stack (this is the default).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional contact (email address or URL) in the User-Agent sent to
# Nominatim and Geofabrik by scripts/osm/osm_bins.py.
OSM_CONTACT=

# Optional: Supabase API URL and service role key for creating the admin
# account. By default they are read from `npm run supabase -- status`.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=
